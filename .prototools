moon = "2.6.1"
node = "26.7.0"
pnpm = "12.9.1"
# wasm-bindgen CLI: generates the JavaScript bindings for the `*-wasm` crates.
# Its version must equal the `wasm-bindgen` crate version in `Cargo.lock`.
wasm-bindgen = "0.2.129"
# shfmt: pi-guardrails parses shell commands with `shfmt --to-json`.
shfmt = "3.14.1"

[plugins.tools]
wasm-bindgen = "file://.config/proto/plugins/wasm-bindgen.toml"
shfmt = "file://.config/proto/plugins/shfmt.toml"
