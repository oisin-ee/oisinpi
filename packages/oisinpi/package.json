{
  "name": "@oisin-ee/oisinpi",
  "version": "0.3.0",
  "description": "Oisin's pi packages in one install: prewalk, todo, wrangle, and guardrails.",
  "keywords": [
    "guardrails",
    "pi-extension",
    "pi-package",
    "prewalk",
    "todo",
    "wrangle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisin-ee/oisinpi.git",
    "directory": "packages/oisinpi"
  },
  "type": "module",
  "dependencies": {
    "@oisin-ee/pi-guardrails": "workspace:*",
    "@oisin-ee/pi-prewalk": "workspace:*",
    "@oisin-ee/pi-todo": "workspace:*",
    "@oisin-ee/pi-wrangle": "0.11.0"
  },
  "bundleDependencies": [
    "@oisin-ee/pi-guardrails",
    "@oisin-ee/pi-prewalk",
    "@oisin-ee/pi-todo",
    "@oisin-ee/pi-wrangle"
  ],
  "pi": {
    "extensions": [
      "./node_modules/@oisin-ee/pi-todo/src/index.ts",
      "./node_modules/@oisin-ee/pi-prewalk/src/index.ts",
      "./node_modules/@oisin-ee/pi-wrangle/pi/index.ts",
      "./node_modules/@oisin-ee/pi-guardrails/src/pi/index.ts"
    ],
    "skills": [
      "./node_modules/@oisin-ee/pi-wrangle/plugins/wrangle/skills"
    ],
    "image": "https://raw.githubusercontent.com/oisin-ee/oisinpi/main/assets/prewalk.png"
  }
}
