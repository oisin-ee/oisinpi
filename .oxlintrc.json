{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // All categories stay at error. Exceptions name their conflicting rule or pi API.
  "categories": { "correctness": "error", "suspicious": "error", "pedantic": "error", "perf": "error", "style": "error", "restriction": "error", "nursery": "error" },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise", "jsdoc"],
  "env": { "node": true },
  "options": { "typeAware": true, "typeCheck": true, "denyWarnings": true, "reportUnusedDisableDirectives": "error" },
  "ignorePatterns": ["packages/*/src/generated/**"],
  "rules": {
    // Contradict import/no-default-export, which stays on.
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    // Contradicts unicorn/prefer-ternary, which stays on.
    "eslint/no-ternary": "off",
    // Contradicts promise/prefer-await-to-then, which stays on.
    "oxc/no-async-await": "off",
    // Contradicts oxc/no-rest-spread-properties, which stays on.
    "eslint/prefer-object-spread": "off",
    // Contradict typescript/promise-function-async for pi's async tool contract.
    "eslint/require-await": "off",
    "typescript/require-await": "off",
    // import/consistent-type-specifier-style requires separate type imports.
    "eslint/no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    // pi context_edit requires null.
    "unicorn/no-null": "off",
    // Contradicts typescript/prefer-optional-chain, which stays on.
    "oxc/no-optional-chaining": "off",
    // Contradicts eslint/no-use-before-define for dependent declarators.
    "eslint/sort-vars": "off",
    // no-use-before-define keeps initializers after effects that supply their input.
    "eslint/one-var": ["error", "consecutive"],
    // pi optional model fields and wasm-bindgen Option inputs require undefined.
    "eslint/no-undefined": "off",
    // TypeBox and pi-ai StringEnum are factories, not constructors.
    "eslint/new-cap": ["error", { "capIsNewExceptionPattern": "^Type\\.", "capIsNewExceptions": ["StringEnum"] }],
    // pi APIs and tsify-generated types are mutable declarations.
    "typescript/prefer-readonly-parameter-types": ["error", { "allow": [
      { "from": "package", "package": "@earendil-works/pi-coding-agent", "name": ["AgentBeforeSettleEvent", "AgentToolUpdateCallback", "ExtensionAPI", "ExtensionCommandContext", "ExtensionContext", "ExtensionToolContext", "SessionBoundaryDraft", "SessionEntry", "SessionStartEvent", "SessionTreeEvent"] },
      { "from": "package", "package": "@earendil-works/pi-ai", "name": ["Model", "ToolResultMessage"] },
      { "from": "lib", "name": "AbortSignal" },
      { "from": "file", "name": ["Action", "Call", "ConfigReport", "Decision", "Event", "Facts", "Flags", "Record", "Selection", "State", "Status", "Task", "Thinking", "TodoList"] }
    ] }]
  },
  "overrides": [
    {
      // pi requires default export and a five-parameter tool execute callback.
      "files": ["packages/*/src/index.ts"],
      "rules": { "import/no-default-export": "off", "eslint/max-params": "off" }
    },
    {
      // pi invokes these callbacks with mutable message unions; context returns those same messages.
      "files": ["packages/pi-prewalk/src/index.ts"],
      "rules": { "typescript/prefer-readonly-parameter-types": "off" }
    },
    {
      // The only file readers: synchronous WASM initialization and live config.
      "files": ["packages/*/src/wasm.ts", "packages/*/src/config.ts"],
      "rules": { "import/no-nodejs-modules": "off", "node/no-sync": "off" }
    },
    {
      "files": ["**/*.test.ts"], "plugins": ["vitest"],
      "rules": {
        // Contradicts vitest/prefer-importing-vitest-globals, which stays on.
        "vitest/no-importing-vitest-globals": "off",
        // Contradict vitest/prefer-strict-boolean-matchers, which stays on.
        "vitest/prefer-to-be-truthy": "off", "vitest/prefer-to-be-falsy": "off"
      }
    }
  ]
}
